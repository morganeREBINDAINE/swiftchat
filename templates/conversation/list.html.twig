{% extends 'base.html.twig' %}

{% block title %}Messages — SwiftChat{% endblock %}

{% block stylesheets %}
<style>
    .unread-badge {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 1.25rem; height: 1.25rem; padding: 0 .35rem;
        border-radius: 999px; background: #6366f1; color: #fff;
        font-size: .7rem; font-weight: 700; margin-left: auto; flex-shrink: 0;
    }
    .unread-badge--hidden { display: none; }
</style>
{% endblock %}

{% block body %}
{% if mercureTopics is not empty %}
<div id="conversations-hub" hidden
     data-mercure-url="{{ mercure(mercureTopics) }}"
     data-current-user="{{ app.user.username }}"></div>
{% endif %}

<div class="page">
    <aside class="sidebar">
        <div class="sidebar__header">
            <span class="sidebar__title">Conversations</span>
            <a href="{{ path('conversation_new') }}" class="btn btn--sm btn--ghost">+ New</a>
        </div>
        <div class="sidebar__list">
            {% for conversation in conversations %}
                {% set other = conversation.getOtherParticipant(app.user) %}
                {% set status = presenceMap[other.id] ?? 'offline' %}
                {% set unread = unreadMap[conversation.id] ?? 0 %}
                <a href="{{ path('conversation_show', { id: conversation.id }) }}"
                   class="conv-item"
                   data-conversation-id="{{ conversation.id }}">
                    <div class="conv-item__name" style="display:flex; align-items:center; gap:.4rem;">
                        <span class="presence-dot presence-dot--{{ status }}"></span>
                        {{ other.username }}
                        <span class="unread-badge {{ unread == 0 ? 'unread-badge--hidden' : '' }}">{{ unread }}</span>
                    </div>
                    <div class="conv-item__date">{{ conversation.updatedAt|date('d M Y, H:i') }}</div>
                </a>
            {% else %}
                <p style="padding:1rem; color:#71717a; font-size:.85rem;">No conversations yet.</p>
            {% endfor %}
        </div>
    </aside>

    <div class="content" style="align-items:center; justify-content:center; background:#f9f9fb;">
        <div style="text-align:center; color:#71717a;">
            <p style="font-size:2rem; margin-bottom:.5rem;">💬</p>
            <p style="font-weight:600; color:#3f3f46;">Select a conversation or start a new one</p>
            <a href="{{ path('conversation_new') }}" class="btn btn--primary" style="margin-top:1rem; display:inline-block;">
                Start a conversation
            </a>
        </div>
    </div>
</div>
{% endblock %}

{% block importmap %}{{ importmap(['app', 'conversations']) }}{% endblock %}
