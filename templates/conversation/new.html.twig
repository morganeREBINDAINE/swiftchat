{% extends 'base.html.twig' %}

{% block title %}New conversation — SwiftChat{% endblock %}

{% block body %}
<div class="auth-page">
    <h1>New conversation</h1>

    <form method="post" action="{{ path('conversation_new') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('new_conversation') }}">

        <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" placeholder="Enter a username…" required autofocus>
        </div>

        <button type="submit" class="btn btn--primary">Start conversation</button>
    </form>

    <a href="{{ path('conversation_list') }}" class="link-secondary">← Back to messages</a>
</div>
{% endblock %}
