{% extends 'base.html.twig' %}

{% block title %}{{ other.username }} — SwiftChat{% endblock %}

{% block stylesheets %}
<style>
    .chat-header { padding: 1rem 1.5rem; background: #fff; border-bottom: 1px solid #e4e4e7; font-weight: 600; display: flex; align-items: center; gap: .75rem; }
    .chat-header__avatar { width: 36px; height: 36px; border-radius: 50%; background: #6366f1; color: #fff; display: flex; align-items: center; justify-content: center; font-size: .85rem; font-weight: 700; flex-shrink: 0; }
    .chat-header__info { display: flex; flex-direction: column; gap: .1rem; }
    .chat-header__presence { display: flex; align-items: center; gap: .35rem; font-weight: 400; font-size: .75rem; color: #71717a; }
    .chat-messages { flex: 1; overflow-y: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem; }
    .message { max-width: 65%; display: flex; flex-direction: column; gap: .2rem; }
    .message--mine { align-self: flex-end; align-items: flex-end; }
    .message--theirs { align-self: flex-start; align-items: flex-start; }
    .message__bubble { padding: .6rem .9rem; border-radius: 1rem; font-size: .9rem; line-height: 1.4; word-break: break-word; }
    .message--mine .message__bubble { background: #6366f1; color: #fff; border-bottom-right-radius: .25rem; }
    .message--theirs .message__bubble { background: #fff; border: 1px solid #e4e4e7; border-bottom-left-radius: .25rem; }
    .message__meta { font-size: .7rem; color: #71717a; }
    .chat-input-area { padding: 1rem 1.5rem; background: #fff; border-top: 1px solid #e4e4e7; }
    .chat-input-form { display: flex; gap: .75rem; align-items: flex-end; }
    .chat-input-form textarea { flex: 1; padding: .6rem .9rem; border: 1px solid #d4d4d8; border-radius: 1.25rem; font-size: .9rem; font-family: inherit; resize: none; max-height: 120px; line-height: 1.4; }
    .chat-input-form textarea:focus { outline: 2px solid #6366f1; border-color: transparent; }
    .chat-input-form button { flex-shrink: 0; }
    .empty-state { text-align: center; color: #71717a; padding: 3rem 1rem; }
    .typing-indicator { min-height: 1.25rem; font-size: .78rem; color: #71717a; font-style: italic; padding: .15rem 1.5rem; }
</style>
{% endblock %}

{% block body %}
<div class="page">
    <aside class="sidebar">
        <div class="sidebar__header">
            <span class="sidebar__title">Conversations</span>
            <a href="{{ path('conversation_new') }}" class="btn btn--sm btn--ghost">+ New</a>
        </div>
        <div class="sidebar__list">
            <a href="{{ path('conversation_list') }}" class="conv-item">
                <div class="conv-item__name" style="color:#6366f1; display:flex; align-items:center; gap:.4rem;">
                    ← All conversations
                    <span id="other-unread-badge" class="unread-badge unread-badge--hidden"></span>
                </div>
            </a>
            <div class="conv-item conv-item--active">
                <div class="conv-item__name" style="display:flex; align-items:center; gap:.4rem;">
                    <span class="presence-dot presence-dot--{{ otherPresence }}"></span>
                    {{ other.username }}
                </div>
                <div class="conv-item__date">{{ conversation.updatedAt|date('d M Y, H:i') }}</div>
            </div>
        </div>
    </aside>

    <div class="content">
        <div class="chat-header">
            <div class="chat-header__avatar">{{ other.username|slice(0, 1)|upper }}</div>
            <div class="chat-header__info">
                <span>{{ other.username }}</span>
                <div class="chat-header__presence">
                    <span id="presence-dot" class="presence-dot presence-dot--{{ otherPresence }}"></span>
                    <span id="presence-label">{{ otherPresence|capitalize }}</span>
                </div>
            </div>
        </div>

        <div class="chat-messages"
             id="chat-messages"
             data-mercure-url="{{ mercure(mercureTopics) }}"
             data-conversation-id="{{ conversation.id }}"
             data-other-id="{{ other.id }}"
             data-mark-read-url="{{ path('conversation_mark_read', {id: conversation.id}) }}"
             data-typing-post-url="{{ path('conversation_typing', {id: conversation.id}) }}"
             data-csrf-typing="{{ csrf_token('typing') }}"
             data-current-user="{{ app.user.username }}">
            {% if messages is empty %}
                <div class="empty-state">
                    <p>No messages yet. Say hello! 👋</p>
                </div>
            {% else %}
                {% for message in messages %}
                    {% set isMine = message.sender == app.user %}
                    <div class="message {{ isMine ? 'message--mine' : 'message--theirs' }}">
                        <div class="message__bubble">{{ message.content|nl2br }}</div>
                        <span class="message__meta">
                            {{ message.createdAt|date('H:i') }}
                            {% if isMine and message.readAt %}✓✓{% elseif isMine %}✓{% endif %}
                        </span>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

        <div id="typing-indicator" class="typing-indicator" hidden></div>

        <div class="chat-input-area">
            <form class="chat-input-form" id="send-form"
                  method="post"
                  action="{{ path('message_send', { id: conversation.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('send_message') }}">
                <textarea name="content"
                          id="message-input"
                          placeholder="Type a message… (Enter to send, Shift+Enter for new line)"
                          rows="1"
                          required></textarea>
                <button type="submit" class="btn btn--primary" id="send-btn">Send</button>
            </form>
        </div>
    </div>
</div>

{% block importmap %}{{ importmap(['app', 'chat', 'conversations']) }}{% endblock %}
{% endblock %}
